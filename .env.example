# Copy to .env and fill values locally. Process environment variables override this file.
# Never commit .env or put secret values in JSON, Python, logs, or source control.
SERPAPI_API_KEY=your-serpapi-api-key
# Optional fallbacks; web search continues with the next configured provider and DDGS.
SERPER_API_KEY=
SERP_PROVIDER_ORDER=serpapi,serper,ddgs
# Optional PageSpeed API key. Local website checks run when the PSI service is disabled or unavailable.
PAGESPEED_API_KEY=
PAGESPEED_ENABLED=1
PAGESPEED_CRUX=0
CRM_ENCRYPTION_KEY_B64=
CRM_SUPPRESSION_HMAC_KEY=
CRM_TENANT_ID=straight-up-digital
AI_DAILY_COST_LIMIT_USD=1.00
CRM_DAILY_AUDIT_LIMIT=
CRM_STORAGE_BACKEND=local
CRM_LOCAL_STORAGE_DIR=reports/objects
CRM_DATABASE_PATH=reports/straight_up_digital.sqlite3
# Generate a random token with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_BEARER_TOKEN=
# Current Netlify production token for report publication; leave unchanged until a separately approved cutover.
# Put the real token in ignored .env only; never commit it or include it in logs.
AUDIT_REPORT_PUBLISH_TOKEN=
# Active report API URL; Netlify remains the current default until Cloudflare is separately tested and approved.
AUDIT_REPORT_PUBLISH_URL=https://straight-up-digital-site.netlify.app/.netlify/functions/publish-audit-report
# Exact account-specific Cloudflare workers.dev hostname (no scheme/path); leave blank to retain the Netlify allowlist.
CLOUDFLARE_WORKER_HOST=
# Separate Cloudflare production secrets; leave blank until the Worker has been configured and tested.
CLOUDFLARE_AUDIT_REPORT_PUBLISH_TOKEN=
CLOUDFLARE_AUDIT_REPORT_PUBLISH_URL=
# Current Netlify production sync token remains separate from the Cloudflare migration token.
# Current plan scopes it to Builds, Functions, and Runtime; keep preview/branch/local values empty.
# Website enquiries are pulled manually from the local CRM; never commit the real token.
CRM_ENQUIRY_SYNC_TOKEN=
CRM_ENQUIRY_SYNC_URL=https://straight-up-digital-site.netlify.app/api/private-enquiries
CLOUDFLARE_CRM_ENQUIRY_SYNC_TOKEN=
CLOUDFLARE_CRM_ENQUIRY_SYNC_URL=
MCP_HOST=127.0.0.1
MCP_PORT=8000
SERPAPI_BASE_URL=https://serpapi.com
NETLIFY_API_BASE_URL=https://api.netlify.com
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CRM_PDF_LOGO_PATH=C:\Users\Saint\Straight Up Digital\straight-up-digital-logo-pngs\02-lockup-horizontal\lockup-light-bg-1000w.png
CRM_HOST=127.0.0.1
CRM_PORT=8765
# Optional HTTPS Paystack hosted page. When set, every generated once-off invoice includes a clickable Paystack button.
# Use a variable-amount/once-off page; the CRM does not create transactions or automatically verify payments.
PAYSTACK_PAYMENT_PAGE_URL=
